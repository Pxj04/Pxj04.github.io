{% extends 'base.html.twig' %}

{% block title %}Post{% endblock %}

{% block body %}
    <h1 class="mb-4">Post</h1>

    <table class="table table-bordered">
        <tbody>
        <tr>
            <th scope="row">Id</th>
            <td>{{ post.id }}</td>
        </tr>
        <tr>
            <th scope="row">Subject</th>
            <td>{{ post.subject }}</td>
        </tr>
        <tr>
            <th scope="row">Description</th>
            <td>{{ post.description }}</td>
        </tr>
        </tbody>
    </table>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_post_index') }}">back to list</a>
        <a class="btn btn-outline-primary" href="{{ path('app_post_edit', {'id': post.id}) }}">edit</a>
        {{ include('post/_delete_form.html.twig') }}
    </div>
{% endblock %}
